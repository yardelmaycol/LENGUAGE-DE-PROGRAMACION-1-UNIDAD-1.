Proceso AREA_ELIPSE
    Definir semiejeMayor, semiejeMenor, area Como Real;

    Escribir "Ingrese el semieje mayor:";
    Leer semiejeMayor;

    Escribir "Ingrese el semieje menor:";
    Leer semiejeMenor;

    area <- PI * semiejeMayor * semiejeMenor;

    Escribir "El area de la elipse es: ", area;
FinProceso
